# Production environment reference for the Koyeb deployment.
# This file is committed as documentation only — copy each value into
# Koyeb's dashboard (Service > Settings > Environment variables), never
# into a real .env.production file (that stays git-ignored / never committed).

APP_NAME=EduCore
APP_ENV=production
APP_KEY=                          # generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-service.koyeb.app
FRONTEND_URL=https://your-app.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database (Aiven MySQL) -------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=                          # e.g. mysql-xxxxx.aivencloud.com
DB_PORT=                          # Aiven's MySQL port (not always 3306)
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
# Paste the *entire* contents of the ca.pem Aiven gives you (Service > Overview
# > "CA certificate") as a multi-line value — the container writes it to a
# file at boot and MYSQL_ATTR_SSL_CA below points PDO at that file.
MYSQL_SSL_CA_CONTENT=
MYSQL_ATTR_SSL_CA=/var/www/html/storage/app/certs/aiven-ca.pem

# --- Sessions / cache / queue -----------------------------------------------
# No `sessions` or `jobs` tables are migrated (this app is a stateless JWT
# API and never dispatches queued jobs), so these must NOT be "database".
SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log

# --- File storage (Backblaze B2, S3-compatible) -----------------------------
# Switches the "public" disk (used for Fichier + Soumission uploads) from
# local disk to B2 — required because Koyeb's free tier filesystem is
# ephemeral and would silently lose every uploaded file on redeploy.
# B2 needs no credit card as long as the bucket is Private (ours always is —
# every file is served through an authenticated Laravel route, never a raw
# bucket URL). Get these from the B2 web console: Buckets > (create a
# Private bucket) > App Keys > "Add a New Application Key" (scope it to just
# that bucket).
UPLOADS_DISK=s3
AWS_ACCESS_KEY_ID=                # the App Key's "keyID"
AWS_SECRET_ACCESS_KEY=            # the App Key's "applicationKey" (shown once — save it)
AWS_DEFAULT_REGION=               # e.g. us-west-004 — the part of your endpoint after "s3."
AWS_BUCKET=educore-uploads
AWS_ENDPOINT=                     # https://s3.<region>.backblazeb2.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Mail --------------------------------------------------------------------
# Unchanged from local dev — emails are logged, not delivered, unless this is
# revisited later with real SMTP credentials.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@educore.test"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_EMAIL=admin@educore.test

# --- CORS --------------------------------------------------------------------
# Comma-separated, no spaces needed (they're trimmed) — include every Vercel
# URL that will call this API (production domain + preview deployments if used).
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# --- Auth ----------------------------------------------------------------
# Generate a fresh secret for production — never reuse the one from local dev.
JWT_SECRET=
JWT_ALGO=HS256

# --- AI (Gemini) -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
